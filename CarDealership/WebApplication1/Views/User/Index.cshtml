@using WebApplication1.Data.Models
@model IEnumerable<ApplicationUser>
@{
    ViewBag.Title = "Users";
}
<h1>Users</h1>
<p>Here is a list of all users</p>
@if (Model.Any())
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Name</th>
                <th>Username</th>
                <th>Cars count</th>
                <th>Details</th>
            </tr>
        </thead>
        <tbody>
            @foreach (ApplicationUser user in Model)
            {
                <tr>
                    <th>@user.FirstName @user.LastName</th>
                    <th>@user.Username</th>
                    <th>@user.Cars.Count</th>
                    <th>
                        <a class="nav-link text-dark" asp-area="" asp-controller="User" asp-action="Details" asp-route-id="@user.Id">Details</a>
                    </th>
                </tr>
            }
        </tbody>
    </table>
}